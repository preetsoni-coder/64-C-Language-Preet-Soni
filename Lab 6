ARMSTRONG NUMBER 

#include <stdio.h>
int main()
{
    int n, t, rem, sum = 0;
    printf(" Preet soni\n Enter a number: ");
    scanf("%d", &n);
    t = n;
    while (t > 0)
    {
        rem = t % 10;
        sum = sum + rem * rem * rem;
        t = t / 10;
    }
    if (sum == n)
        printf("Armstrong Number");
    else
        printf("Not an Armstrong Number");
    return 0;
}


COUNTING PRIME 

#include <stdio.h>

int main()
{
    int n, num, i, flag, count = 0;
    printf(" PREET SONI\n");
    for(num = 2; num <= 100; num++)
    {
        flag = 0;

        for(i = 2; i * i <= num; i++)
        {
            if(num % i == 0)
            {
                flag = 1;
                break;
            }
        }

        if(flag == 0)
            count++;
    }

    printf("Total prime numbers = %d", count);
    return 0;
}

OPERATOR PRECEDENCE

#include <stdio.h>

    int main() {
