# RELATIONAL OPERATOR 

#include <stdio.h>
int main()
{
   int a=12 , b= 9;

  printf("a>b = %d\n", a>b );
  printf("a<b = %d\n", a<b );
  printf("a>=b = %d\n", a>=b );
  printf("a<=b = %d\n", a<=b );
  printf("a==b = %d\n", a==b );
  printf("a!=b = %d\n", a!=b );

  return 0;
}


#BITWISE OPERATOR

#include<stdio.h>
 int main ()
{
    int a = 5, b = 3;

    printf("a & b = %d\n", a & b);
    printf("a | b = %d\n", a | b);
    printf("a ^ b = %d\n", a ^ b);
    printf("~a = %d\n", ~a);
    printf("a << 1 = %d\n", a << 1);
    printf("a >> 1 = %d\n", a >> 1);

    return 0;
}
