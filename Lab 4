# INCREMENT PROGRAM 

#include <stdio.h>
int main()
{
    int a;
    printf("Enter a number: ");
    scanf("%d", &a);

    printf("Value before increment = %d\n", a++);

    printf("Value after increment = %d\n", a);

    return 0;
}


# DECREMENT PROGRAM 

# include<stdio.h>
  int main()
{
    int a;
    printf("Enter a number: ");
    scanf("%d", &a);

    printf("Value before decrement = %d\n", a--)

    printf("Value after decrement = %d\n", a);

    return 0;
}


