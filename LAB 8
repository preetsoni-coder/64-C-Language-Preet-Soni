PALINDROME NUMBER 

#include <stdio.h>
int main()
{
    int n, t, r = 0, rem;
    printf("PREET SONI\nEnter a number: ");
    scanf("%d", &n);
    t = n;
    while(n > 0)
    {
        rem = n % 10;
        r = r * 10 + rem;
        n = n / 10;
    }
    if(t == r)
        printf("It is Palindrome Number");
    else
        printf("It is not Palindrome Number");
    return 0;
}

SWITCH CASE

#include <stdio.h>

int main()
{
    int day;
    printf("PREET SONI\n");
    printf("Enter day number (1-7): ");
    scanf("%d", &day);

    switch(day)
    {
        case 1:
            printf("Monday");
            break;

        case 2:
            printf("Tuesday");
            break;

        case 3:
            printf("Wednesday");
            break;

        case 4:
            printf("Thursday");
            break;

        case 5:
            printf("Friday");
            break;

        case 6:
            printf("Saturday");
            break;

        case 7:
            printf("Sunday");
            break;

        default:
            printf("Invalid day");
    }

    return 0;
}
